# ============================================================
# Money Printer — Kalshi Bot environment variables
# Copy to .env and fill in real values. Never commit .env.
#
# Every variable here is verified against os.environ.get() calls
# in the live bot's .py files. See ARCHITECTURE.md § Live Config
# for file:line citations.
# ============================================================

# --------------- Kalshi API credentials — LIVE ---------------

# Live API key ID (UUID, from kalshi.com → Account → API Keys)
KALSHI_API_KEY=your-live-api-key-id-here

# Live RSA private key — PEM string with literal \n between lines,
# or path to a .pem file (e.g. ./kalshi_private_key.pem)
KALSHI_PRIVATE_KEY=./kalshi_private_key.pem

# --------------- Kalshi API credentials — DEMO ---------------

# Demo API key ID (UUID, from demo-api.kalshi.co → API Keys)
KALSHI_DEMO_API_KEY=your-demo-api-key-id-here

# Demo RSA private key — same format as live key
KALSHI_DEMO_PRIVATE_KEY=./kalshi_demo_private_key.pem

# --------------- Bot behaviour ---------------

# Execution mode: paper | demo | live
# paper — simulates fills, no real orders, no real credentials needed
# demo  — real orders on Kalshi demo environment
# live  — real orders with real money; requires KALSHI_API_KEY
# Default: paper (from config.json; this env var overrides it)
# Read by: bot_infra.py:142
BOT_MODE=paper

# Override bot_enabled in config.json without editing the file.
# true | false  (1/yes also accepted)
# Read by: bot_infra.py:144
BOT_ENABLED=false

# --------------- File paths ---------------

# Path to config.json. Default: config.json (repo root).
# Read by: bot_state.py:45
BOT_CONFIG_FILE=config.json

# Path to the SQLite database file.
# On Railway, set to /app/data/kalshi_bot.db (volume mount).
# Default: kalshi_bot.db
# Read by: bot_state.py:46, server.py, notify.py
BOT_DB_FILE=/app/data/kalshi_bot.db

# Path to bot_state.json (runtime state snapshot written by bot.py).
# Default: bot_state.json
# Read by: bot_state.py:47, server.py
BOT_STATE_FILE=bot_state.json

# --------------- Notifications ---------------

# Telegram bot token (from @BotFather). Leave blank to disable alerts.
# Read by: bot_state.py:42, notify.py:29
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to send alerts to. Required if TELEGRAM_BOT_TOKEN is set.
# Read by: bot_state.py:43, notify.py:30
TELEGRAM_CHAT_ID=

# --------------- Infrastructure ---------------

# Log output format: json (default, structured for Railway) | text (human-readable)
# Read by: obs.py:90
LOG_FORMAT=json

# Port for the gunicorn dashboard server.
# Railway sets this automatically; override only for local dev.
# Used by: start.sh (bash), not read by Python directly.
PORT=5000
