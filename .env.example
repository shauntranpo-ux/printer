# ============================================================
# kalshi-botv3 — environment variable reference
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --------------- Kalshi API credentials ---------------

# Your Kalshi API key ID (UUID format, found in Account → API Keys)
KALSHI_API_KEY_ID=your-api-key-id-here

# Absolute or relative path to the RSA private key PEM file downloaded
# from Kalshi when you created the API key
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Target environment: "demo" for the sandbox, "prod" for live trading
# Default: demo
KALSHI_ENV=demo

# --------------- Bot behaviour ---------------

# Execution mode:
#   dry_run  — runs all logic but places no orders (safe default)
#   paper    — simulates fills without real money
#   live     — places real orders; requires KALSHI_ENV=prod
# Default: dry_run
MODE=dry_run

# --------------- Infrastructure ---------------

# SQLite connection URL. The data/ directory must exist.
# Default: sqlite+aiosqlite:///./data/bot.db
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Log verbosity: DEBUG | INFO | WARNING | ERROR
# Default: INFO
LOG_LEVEL=INFO

# TCP port for the FastAPI health/dashboard server
# Default: 8080
HEALTH_PORT=8080

# Path to the runtime YAML config file
# Default: src/kalshi_botv3/config/config.yaml
CONFIG_PATH=src/kalshi_botv3/config/config.yaml
