# ============================================================
# kalshi-botv3 — environment variable reference
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --------------- Kalshi API credentials — LIVE ---------------

# Your live Kalshi API key ID (UUID format, found in Account → API Keys)
KALSHI_API_KEY=your-live-api-key-id-here

# Live RSA private key — PEM string or path to .pem file (e.g. ./kalshi_private_key.pem)
KALSHI_PRIVATE_KEY=./kalshi_private_key.pem

# --------------- Kalshi API credentials — DEMO ---------------

# Your demo Kalshi API key ID (UUID format, found in demo.kalshi.co → API Keys)
KALSHI_DEMO_API_KEY=your-demo-api-key-id-here

# Demo RSA private key — PEM string or path to .pem file (e.g. ./kalshi_demo_private_key.pem)
KALSHI_DEMO_PRIVATE_KEY=./kalshi_demo_private_key.pem

# --------------- Bot behaviour ---------------

# Execution mode:
#   dry_run  — runs all logic but places no orders (safe default)
#   paper    — simulates fills without real money
#   live     — places real orders; requires KALSHI_ENV=prod
# Default: dry_run
MODE=dry_run

# --------------- Infrastructure ---------------

# SQLite connection URL. The data/ directory must exist.
# Default: sqlite+aiosqlite:///./data/bot.db
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Log verbosity: DEBUG | INFO | WARNING | ERROR
# Default: INFO
LOG_LEVEL=INFO

# TCP port for the FastAPI health/dashboard server
# Default: 8080
HEALTH_PORT=8080

# Path to the runtime YAML config file
# Default: src/kalshi_botv3/config/config.yaml
CONFIG_PATH=src/kalshi_botv3/config/config.yaml
