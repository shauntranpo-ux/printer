.ruff_cache/
.mypy_cache/
.pytest_cache/

# Secrets
*.pem

# Bot state
bot_state.json
bot_state_*.json
config.json

# Backtest outputs — large files, not committed
results/*.parquet
data/historical/*.parquet

# OS
.DS_Store
Thumbs.db
start.bat
.claude/

