# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*
!.env.example

# Database
*.db
*.db-journal

# Logs
logs/
*.log
brain.log

